# Database (Neon / Supabase PostgreSQL) — REQUIRED on Vercel for real orders.
# Without this, checkout may appear to succeed but confirmation shows "Order not found"
# (in-memory demo orders do not survive serverless).
# Neon’s Vercel integration may inject zayune_web_POSTGRES_PRISMA_URL instead —
# the app maps that automatically. Prefer also setting a plain DATABASE_URL.
DATABASE_URL="postgresql://user:password@host:5432/zayune?sslmode=require"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"

# Admin credentials (v1 single admin)
ADMIN_EMAIL="admin@zayune.com"
ADMIN_PASSWORD="change-me"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@zayune.com"
# Comma-separated team inbox for new orders / support tickets
ORDER_NOTIFY_EMAILS="hello@zayune.com,studio@zayune.com"

# Vercel Blob (image uploads). Optional locally — falls back to data URLs.
BLOB_READ_WRITE_TOKEN=""

# WhatsApp order link
NEXT_PUBLIC_SITE_URL="https://zayune.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/zayune.pk/"
NEXT_PUBLIC_STUDIO_EMAIL="hello@zayune.com"
# With DATABASE_URL set, demo mode is off unless FORCE_DEMO_DATA=true
USE_DEMO_DATA="false"
FORCE_DEMO_DATA="false"

# Bank transfer details (shown at checkout)
BANK_NAME="[Bank name]"
BANK_ACCOUNT_TITLE="ZAYUNE"
BANK_ACCOUNT_NUMBER="[Account number]"
BANK_IBAN="[IBAN / Raast ID]"

# Optional local gateway (Safepay / PayFast / Paymob)
PAYMENT_GATEWAY_PROVIDER="none"
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_SECRET=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""
